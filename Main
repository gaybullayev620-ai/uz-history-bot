import os, json, asyncio, time, hashlib, random, math, requests
import edge_tts
from moviepy import (VideoFileClip, AudioFileClip, TextClip, CompositeVideoClip,
                     concatenate_videoclips, vfx)

E = os.environ
W, H = 1080, 1920
VOICE = "uz-UZ-SardorNeural"
FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
SHOT = 2.2          # har bir kadr taxminan necha soniya
os.makedirs("out", exist_ok=True)

# 1) Ssenariy (Gemini)
used = json.load(open("used_topics.json"))
prompt = """Sen Instagram Reels uchun viral tarixiy videolar yozadigan ssenaristsan.
O'zbekiston hududi (Turon, Sug'd, Xorazm, Farg'ona, Buxoro, Samarqand, Movarounnahr) tarixidan
eng HAYRATLANARLI, ko'pchilik bilmaydigan yoki noto'g'ri tushunadigan BITTA mavzu tanla.
Yo'nalish namunalari (aynan shular shart emas): Farg'ona "samoviy otlari" uchun bo'lgan urush,
"algoritm" so'zining Xorazmiy bilan aloqasi, Ulug'bekning yulduzlar bilan ishi, qog'oz sirlari,
Afrosiyob devoriy rasmlaridagi elchilar, Sug'diylar - Ipak yo'li savdogarlari, Buxoro va Samarqand sirlari.
QOIDALAR:
- Faqat yaxshi hujjatlashtirilgan faktlar. Ishonching komil bo'lmagan sana, raqam, iqtibosni YOZMA. Hech narsa to'qima.
- Do'stingga sirni aytib berayotgandek, jonli va sodda tilda yoz. Qiziqarli hikoya bo'lsin, quruq darslik emas.
- 9-11 ta qisqa gap (har biri 7-12 so'z), o'zbek tilida (lotin), jami 45-55 soniya.
- Birinchi gap ZARBA bo'lsin: kutilmagan fakt yoki "Sizga aytishgan ... aslida yolg'on" kabi gap.
- Keyingi gaplarda voqeani hikoya qil: kim, qayerda, nima uchun, kutilmagan burilish.
- Oxirgi gap kutilmagan xulosa bo'lsin va izoh yozishga undasin.
- Har bir gap uchun 3 ta "keywords": ko'z bilan KO'RINADIGAN narsalarni ifodalovchi oddiy inglizcha 1-3 so'zli
  iboralar (masalan "desert caravan", "horses galloping", "old mosque dome", "night sky stars", "ancient ruins",
  "old manuscript"). Nomlar va mavhum so'zlar ishlatma.
""" + f"Bu mavzularni takrorlama: {used}\n" + """Faqat JSON qaytar:
{"topic": "...", "caption": "qiziqarli izoh + 5 ta hashtag",
 "sentences": [{"text": "o'zbekcha gap", "keywords": ["a", "b", "c"]}]}"""
data = None
for model in ["gemini-3.5-flash", "gemini-3.1-flash-lite", "gemini-2.5-flash"]:
    r = requests.post(
        f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
        params={"key": E["GEMINI_API_KEY"]},
        json={"contents": [{"parts": [{"text": prompt}]}],
              "generationConfig": {"responseMimeType": "application/json"}}, timeout=180)
    print(model, "->", r.status_code)
    if r.ok:
        data = json.loads(r.json()["candidates"][0]["content"]["parts"][0]["text"])
        break
    print(r.text[:300])
if data is None:
    raise SystemExit("Gemini ishlamadi: kalit yoki model nomini tekshiring")
print("Mavzu:", data["topic"])

# 2) Pixabay video
cache, used_links, counter = {}, set(), [0]

def search(q):
    if q not in cache:
        res = requests.get("https://pixabay.com/api/videos/",
            params={"key": E["PEXELS_API_KEY"], "q": q, "per_page": 15}, timeout=60).json()
        cache[q] = res.get("hits", [])
    return cache[q]

def get_video(q):
    for query in (q, "ancient architecture", "desert landscape", "old city"):
        for h in search(query):
            vid = h["videos"]
            link = (vid.get("medium") or vid["small"])["url"]
            if link not in used_links:
                used_links.add(link)
                counter[0] += 1
                path = f"out/v{counter[0]}.mp4"
                open(path, "wb").write(requests.get(link, timeout=180).content)
                return path
    raise SystemExit("Pixabay'dan video topilmadi")

def fill(v):
    """Videoni butun 1080x1920 ekranni to'ldiradigan qilib kattalashtirib, markazdan kesadi."""
    sc = max(W / v.w, H / v.h)
    v = v.resized((math.ceil(v.w * sc) + 1, math.ceil(v.h * sc) + 1))
    return v.cropped(x_center=v.w / 2, y_center=v.h / 2, width=W, height=H)

def chunks(text, limit=22):
    out, cur = [], ""
    for w in text.split():
        if cur and len(cur) + 1 + len(w) > limit:
            out.append(cur); cur = w
        else:
            cur = (cur + " " + w).strip()
    if cur: out.append(cur)
    return out

# 3) Ovoz + tez almashadigan kadrlar + kichik subtitrlar
async def tts(text, path):
    await edge_tts.Communicate(text, VOICE, rate="+8%").save(path)

parts = []
for i, s in enumerate(data["sentences"]):
    ap = f"out/a{i}.mp3"
    asyncio.run(tts(s["text"], ap))
    audio = AudioFileClip(ap)
    d = audio.duration + 0.15
    kws = s["keywords"] if isinstance(s["keywords"], list) else [s["keywords"]]
    n = max(1, round(d / SHOT))
    sd = d / n
    shots = []
    for k in range(n):
        v = VideoFileClip(get_video(kws[k % len(kws)])).without_audio()
        if v.duration > sd + 0.5:
            st = random.uniform(0, v.duration - sd - 0.1)
            v = v.subclipped(st, st + sd)
        else:
            v = v.with_effects([vfx.Loop(duration=sd)])
        shots.append(fill(v).with_duration(sd))
    base = concatenate_videoclips(shots)
    cs = chunks(s["text"])
    total = sum(len(c) for c in cs)
    layers, t = [base], 0.0
    for c in cs:
        cd = d * len(c) / total
        tc = TextClip(font=FONT, text=c, font_size=72, color="white",
                      stroke_color="black", stroke_width=5, method="caption",
                      size=(W - 200, None), text_align="center")
        layers.append(tc.with_start(t).with_duration(cd).with_position(("center", 1150)))
        t += cd
    parts.append(CompositeVideoClip(layers, size=(W, H)).with_duration(d).with_audio(audio))

final = concatenate_videoclips(parts)
final.write_videofile("out/final.mp4", fps=30, codec="libx264", audio_codec="aac", preset="veryfast")

if E.get("DRY_RUN", "true").lower() == "true":
    print("DRY_RUN: Instagramga joylanmadi. Videoni Artifacts'dan ko'ring.")
    raise SystemExit

# 4) Cloudinary (ochiq URL uchun)
ts = str(int(time.time()))
sig = hashlib.sha1(f"timestamp={ts}{E['CLOUDINARY_SECRET']}".encode()).hexdigest()
up = requests.post(f"https://api.cloudinary.com/v1_1/{E['CLOUDINARY_CLOUD']}/video/upload",
    data={"timestamp": ts, "api_key": E["CLOUDINARY_KEY"], "signature": sig},
    files={"file": open("out/final.mp4", "rb")}, timeout=600)
up.raise_for_status()
url = up.json()["secure_url"]

# 5) Instagram Reels
G = "https://graph.instagram.com/v26.0"
c = requests.post(f"{G}/{E['IG_USER_ID']}/media", data={
    "media_type": "REELS", "video_url": url,
    "caption": data["caption"], "access_token": E["IG_TOKEN"]}).json()
cid = c["id"]
for _ in range(40):
    st = requests.get(f"{G}/{cid}", params={"fields": "status_code", "access_token": E["IG_TOKEN"]}).json()
    if st.get("status_code") == "FINISHED": break
    if st.get("status_code") == "ERROR": raise SystemExit(f"IG xato: {st}")
    time.sleep(15)
p = requests.post(f"{G}/{E['IG_USER_ID']}/media_publish",
    data={"creation_id": cid, "access_token": E["IG_TOKEN"]}).json()
print("Joylandi:", p)

used.append(data["topic"])
json.dump(used, open("used_topics.json", "w"), ensure_ascii=False, indent=1)

